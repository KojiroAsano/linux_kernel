/* ============================================================================
 * link.lds — カーネルのリンカスクリプト
 * ============================================================================
 * ld(リンカ)は、複数の.oファイル(kernel.o, main.o, trap.o, ...)を
 * 1つの実行ファイル(kernel)にまとめる際、「どのセクションを、
 * メモリ上のどこに、どういう順番で配置するか」を決める必要がある。
 * このファイルはその配置ルールを指定するもの(build.shの
 * `ld -T link.lds ...`で使われている)。
 * ========================================================================= */

OUTPUT_FORMAT("elf64-x86-64")  /* 出力ファイルの形式(64bit ELF) */
ENTRY(start)                    /* エントリポイント。kernel.asmのstart:ラベルが
                                  * 実行開始位置になる */

SECTIONS
{
    /* ここから先のセクションを、仮想アドレス0xffff800000200000
     * (KERNEL_BASE + 2MB)から順に並べていく。この値はloader.asmが
     * ジャンプしてくる先のアドレスと一致している必要がある。
     * higher-halfカーネル(仮想アドレス空間の上位半分を使う設計)
     * なので、通常の0x200000のような低いアドレスではなく、
     * わざとこの大きな値になっている。 */
    . = 0xffff800000200000;

    /* .text: 実行可能な命令(コード)をまとめる */
    .text : {
        *(.text)
    }

    /* .rodata: 書き換えない定数データ(文字列リテラルなど)をまとめる */
    .rodata : {
        *(.rodata)
    }

    /* .dataセクションの前に、アドレスを16バイト境界へ揃える
     * (8バイト単位のデータなどを効率よく読み書きするため) */
    . = ALIGN(16);

    /* .data: 初期値を持つグローバル変数・静的変数をまとめる */
    .data : {
        *(.data)
    }

    /* .bss: 初期値が0のグローバル変数・静的変数をまとめる。
     * (実行ファイルの中には中身を持たず、「起動時にこの範囲を
     *  0クリアしてね」というサイズの情報だけが入る) */
    .bss : {
        *(.bss)
    }

    /* endという名前のシンボルを、ここまでの全セクションの直後の
     * アドレスとして定義する。「.」は今の配置位置(=カーネルの
     * 実行ファイルが占める範囲の終わり)を表す。
     * memory.cが extern char end; という形でこの値を参照し、
     * 「カーネル自身が使っている範囲の直後から、空きメモリとして
     * 配ってよい」という境界線に使っている。 */
    PROVIDE(end = .);
}
