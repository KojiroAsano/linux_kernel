/* ============================================================================
 * link.lds(ユーザーランド版) — ユーザープログラムのリンカスクリプト
 * ============================================================================
 * カーネル側のlink.ldsと考え方は同じだが、配置するアドレスが違う。
 * process.cのsetup_uvm()(memory.c)が、このプログラムを必ず仮想アドレス
 * 0x400000から1ページ(2MB)分マップするので、ここでのベースアドレスも
 * それに合わせて0x400000にしておく必要がある。
 * ========================================================================= */

OUTPUT_FORMAT("elf64-x86-64")
ENTRY(start)    /* start.asmのstart:が最初に実行される */

SECTIONS
{
    . = 0x400000;

    .text : {
        *(.text)
    }

    .rodata : {
        *(.rodata)
    }

    . = ALIGN(16);

    .data : {
        *(.data)
    }

    .bss : {
        *(.bss)
    }
}
